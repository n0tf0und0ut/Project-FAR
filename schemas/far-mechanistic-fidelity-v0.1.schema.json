{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "status",
    "id",
    "data_class",
    "registered_at",
    "model",
    "explanation",
    "sources",
    "cases"
  ],
  "properties": {
    "format_version": {
      "const": "FAR-MECH/0.1"
    },
    "status": {
      "const": "Research"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
    },
    "data_class": {
      "enum": [
        "synthetic",
        "submitted_experiment"
      ]
    },
    "registered_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "component_id",
        "intervention_type",
        "reference_population_sha256"
      ],
      "properties": {
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "component_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
        },
        "intervention_type": {
          "const": "single_component_activation_replacement"
        },
        "reference_population_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "hypothesis_source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "hypothesis_source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "split",
          "input_sha256",
          "measured_at",
          "source_ids",
          "observed_activation",
          "explained_activation",
          "baseline_activation",
          "original_probs",
          "replacement_probs",
          "baseline_probs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
          },
          "split": {
            "enum": [
              "heldout",
              "adversarial",
              "control"
            ]
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "measured_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
            }
          },
          "observed_activation": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,6})?$"
          },
          "explained_activation": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,6})?$"
          },
          "baseline_activation": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,6})?$"
          },
          "original_probs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(?:0(?:\\.[0-9]{1,6})?|1(?:\\.0{1,6})?)$"
            }
          },
          "replacement_probs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(?:0(?:\\.[0-9]{1,6})?|1(?:\\.0{1,6})?)$"
            }
          },
          "baseline_probs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(?:0(?:\\.[0-9]{1,6})?|1(?:\\.0{1,6})?)$"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.invalid/schemas/far-mechanistic-fidelity-v0.1.schema.json"
}
