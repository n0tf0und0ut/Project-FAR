{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.invalid/commercial/far-epistemic-debugger-1.0.schema.json",
  "title": "FAR Epistemic Debugger application envelope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "input_sha256",
    "claims",
    "evidence_semantics",
    "collisions",
    "readings",
    "graph",
    "cognitive",
    "epistemic_interchange",
    "source_lineage",
    "audit_assurance",
    "unknowns",
    "runtime_identity"
  ],
  "properties": {
    "schema": {
      "const": "far-epistemic-debugger/1.0"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "object"
    },
    "evidence_semantics": {
      "type": "object"
    },
    "collisions": {
      "type": "array"
    },
    "readings": {
      "type": "array"
    },
    "graph": {
      "type": "object"
    },
    "cognitive": {
      "type": "object"
    },
    "epistemic_interchange": {
      "type": "object"
    },
    "source_lineage": {
      "type": "array"
    },
    "audit_assurance": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    },
    "runtime_identity": {
      "type": "object"
    }
  }
}
