    {
      "id": "CONFIG-10",
      "category": "integration",
      "goal": "Both service and CLI must use the same validated timeout: absent or null means default 30 seconds; otherwise only an integer 1..3600 is valid (booleans are invalid). Invalid values must produce {\"error\":\"INVALID_TIMEOUT\"} without silently defaulting.",
      "files": {
        "solution.py": "from config import service_timeout, cli_timeout\n\ndef transform(d):\n    try:\n        return {\"service\":service_timeout(d), \"cli\":cli_timeout(d)}\n    except ValueError:\n        return {\"error\":\"INVALID_TIMEOUT\"}\n",
        "config.py": "def service_timeout(d):\n    return d.get(\"timeout\") or 30\n\ndef cli_timeout(d):\n    return int(d.get(\"timeout\") or 30)\n"
      },
      "allowed_changes": [
        "config.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {},
          "expected": {
            "service": 30,
            "cli": 30
          }
        },
        {
          "input": {
            "timeout": 5
          },
          "expected": {
            "service": 5,
            "cli": 5
          }
        }
      ],
      "hidden": [
        {
          "input": {
            "timeout": null
          },
          "expected": {
            "service": 30,
            "cli": 30
          }
        },
        {
          "input": {
            "timeout": true
          },
          "expected": {
            "error": "INVALID_TIMEOUT"
          }
        },
        {
          "input": {
            "timeout": 0
          },
          "expected": {
            "error": "INVALID_TIMEOUT"
          }
        },
        {
          "input": {
            "timeout": 3601
          },
          "expected": {
            "error": "INVALID_TIMEOUT"
          }
        }
      ]
    }
  ]
