    {
      "id": "REUSE-06",
      "category": "maintainability",
      "goal": "Use the existing shared slugify helper in shared.py for every catalog item. Preserve item order; do not add a second independent slugification algorithm.",
      "files": {
        "solution.py": "from catalog import slugs\n\ndef transform(d):\n    return slugs(d[\"items\"])\n",
        "shared.py": "import re\n\ndef slugify(s):\n    return re.sub(r\"[^a-z0-9]+\", \"-\", s.strip().casefold()).strip(\"-\")\n",
        "catalog.py": "def slugs(items):\n    return [x.lower().replace(\" \",\"-\") for x in items]\n"
      },
      "allowed_changes": [
        "catalog.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "items": [
              "Hello World"
            ]
          },
          "expected": [
            "hello-world"
          ]
        },
        {
          "input": {
            "items": [
              " ABC ",
              "D E"
            ]
          },
          "expected": [
            "abc",
            "d-e"
          ]
        }
      ],
      "hidden": [
        {
          "input": {
            "items": [
              " A--B ",
              "C!!!"
            ]
          },
          "expected": [
            "a-b",
            "c"
          ]
        },
        {
          "input": {
            "items": []
          },
          "expected": []
        },
        {
          "input": {
            "items": [
              "Foo  Bar",
              "FOO BAR"
            ]
          },
          "expected": [
            "foo-bar",
            "foo-bar"
          ]
        },
        {
          "input": {
            "items": [
              "$Cash#",
              " x_y "
            ]
          },
          "expected": [
            "cash",
            "x-y"
          ]
        }
      ]
    },
    {
      "id": "JOURNAL-07",
      "category": "integrity",
      "goal": "Apply append-only events to a copied initial dictionary: new nonempty string IDs and integer (not bool) values are accepted; duplicates or invalid records are rejected without changing earlier values. Return state and rejected event indices.",
      "files": {
        "solution.py": "from journal import apply\n\ndef transform(d):\n    return apply(d[\"initial\"], d[\"events\"])\n",
        "journal.py": "def apply(initial, events):\n    initial.update({e[\"id\"]:e[\"value\"] for e in events})\n    return {\"state\":initial,\"rejected\":[]}\n"
      },
      "allowed_changes": [
        "journal.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "initial": {},
            "events": [
              {
                "id": "a",
                "value": 1
              }
            ]
          },
          "expected": {
            "state": {
              "a": 1
            },
            "rejected": []
          }
        },
        {
          "input": {
            "initial": {
              "a": 1
            },
            "events": [
              {
                "id": "a",
                "value": 2
              }
            ]
          },
          "expected": {
