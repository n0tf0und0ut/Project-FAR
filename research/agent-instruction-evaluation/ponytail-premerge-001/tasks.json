    {
      "id": "FROZEN-09",
      "category": "governance",
      "goal": "Never modify an existing record where frozen=true. Allow creating new records or updating unfrozen ones; do not mutate the caller-provided records dictionary. Return {accepted:boolean,records:copy}.",
      "files": {
        "solution.py": "from evidence import apply_update\n\ndef transform(d):\n    return apply_update(d[\"records\"],d[\"id\"],d[\"value\"])\n",
        "evidence.py": "def apply_update(records, id, value):\n    records[id]={\"frozen\":False,\"value\":value}\n    return {\"accepted\":True,\"records\":records}\n"
      },
      "allowed_changes": [
        "evidence.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "records": {},
            "id": "a",
            "value": 1
          },
          "expected": {
            "accepted": true,
            "records": {
              "a": {
                "frozen": false,
                "value": 1
              }
            }
          }
        },
        {
          "input": {
            "records": {
              "a": {
                "frozen": true,
                "value": 1
              }
            },
            "id": "a",
            "value": 2
          },
          "expected": {
            "accepted": false,
            "records": {
              "a": {
                "frozen": true,
                "value": 1
              }
            }
          }
        }
      ],
      "hidden": [
        {
          "input": {
            "records": {
