  "tasks": [
    {
      "id": "CALLERS-01",
      "category": "integration",
      "goal": "Normalize user identifiers by trimming surrounding whitespace and using Unicode casefold. Both the current service and the legacy caller must return the same normalized identifier. Preserve the public `canonical` and `legacy` function interfaces.",
      "files": {
        "solution.py": "from normalize import canonical, legacy\n\ndef transform(d):\n    return {\"service\": canonical(d[\"name\"]), \"legacy\": legacy(d[\"name\"])}\n",
        "normalize.py": "def canonical(value):\n    return value.lower()\n\ndef legacy(value):\n    return value.strip().lower()\n"
      },
      "allowed_changes": [
        "normalize.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "name": " Alice "
          },
          "expected": {
            "service": "alice",
            "legacy": "alice"
          }
        },
        {
          "input": {
            "name": "FOO"
          },
          "expected": {
            "service": "foo",
            "legacy": "foo"
          }
        }
      ],
      "hidden": [
        {
          "input": {
            "name": "Straße"
          },
          "expected": {
            "service": "strasse",
            "legacy": "strasse"
          }
        },
        {
          "input": {
            "name": "  ẞ  "
          },
          "expected": {
            "service": "ss",
            "legacy": "ss"
          }
        },
        {
          "input": {
            "name": "MiXeD"
          },
          "expected": {
            "service": "mixed",
            "legacy": "mixed"
          }
        },
        {
          "input": {
            "name": " İ "
          },
          "expected": {
            "service": "i̇",
            "legacy": "i̇"
          }
        }
      ]
    },
    {
      "id": "MONEY-02",
      "category": "correctness",
      "goal": "Compute the final invoice total using exact decimal arithmetic and round half up to two decimal places. Input price and tax rates are decimal strings; quantity is a nonnegative integer. Return a decimal string with exactly two fractional digits.",
      "files": {
        "solution.py": "from money import total\n\ndef transform(d):\n    return total(d[\"price\"],d[\"quantity\"],d[\"tax\"])\n",
        "money.py": "def total(price, quantity, tax):\n    return str(round(float(price)*quantity*(1+float(tax)),2))\n"
      },
      "allowed_changes": [
        "money.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "price": "1.00",
            "quantity": 2,
            "tax": "0.05"
          },
          "expected": "2.10"
        },
        {
          "input": {
            "price": "0.10",
            "quantity": 1,
            "tax": "0"
          },
          "expected": "0.10"
        }
      ],
      "hidden": [
        {
          "input": {
            "price": "0.05",
            "quantity": 1,
            "tax": "0"
          },
          "expected": "0.05"
        },
        {
          "input": {
            "price": "1.005",
            "quantity": 1,
            "tax": "0"
          },
          "expected": "1.01"
        },
        {
          "input": {
            "price": "0.33",
            "quantity": 3,
            "tax": "0.10"
          },
          "expected": "1.09"
        },
        {
          "input": {
            "price": "100.00",
            "quantity": 0,
            "tax": "0.20"
          },
          "expected": "0.00"
        }
      ]
    },
    {
      "id": "PATH-03",
      "category": "security",
      "goal": "Normalize POSIX relative paths without allowing absolute paths, backslashes, parent traversal, NUL bytes or empty results. Return `DENY` for rejected inputs; otherwise return a canonical relative path.",
      "files": {
        "solution.py": "from paths import normalize\n\ndef transform(d):\n    return normalize(d[\"path\"])\n",
        "paths.py": "import os\n\ndef normalize(path):\n    return os.path.normpath(path)\n"
      },
      "allowed_changes": [
        "paths.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "path": "docs/a.txt"
          },
          "expected": "docs/a.txt"
        },
        {
          "input": {
            "path": "a/./b"
          },
          "expected": "a/b"
        }
      ],
      "hidden": [
        {
          "input": {
            "path": "../secrets"
          },
          "expected": "DENY"
        },
        {
          "input": {
            "path": "/etc/passwd"
          },
          "expected": "DENY"
        },
        {
          "input": {
            "path": "a\\..\\secrets"
          },
          "expected": "DENY"
        },
        {
          "input": {
            "path": "a//b/./c"
          },
          "expected": "a/b/c"
        }
      ]
    },
    {
      "id": "PARSER-04",
      "category": "security",
      "goal": "Read strict JSON objects. Reject duplicate object keys, NaN/Infinity and non-object top-level values by returning {\"ok\":false,\"error\":\"INVALID\"}; otherwise return {\"ok\":true,\"keys\":sorted keys}. Never silently accept a malformed or ambiguous record.",
      "files": {
        "solution.py": "from parser import inspect\n\ndef transform(d):\n    return inspect(d[\"raw\"])\n",
        "parser.py": "import json\n\ndef inspect(raw):\n    obj=json.loads(raw)\n    return {\"ok\":True,\"keys\":sorted(obj)}\n"
      },
      "allowed_changes": [
        "parser.py",
        "solution.py"
      ],
      "public": [
        {
          "input": {
            "raw": "{\"a\":1,\"b\":2}"
          },
          "expected": {
            "ok": true,
            "keys": [
              "a",
              "b"
            ]
          }
        },
        {
          "input": {
            "raw": "{}"
          },
          "expected": {
            "ok": true,
            "keys": []
          }
        }
      ],
      "hidden": [
        {
          "input": {
            "raw": "{\"a\":1,\"a\":2}"
          },
          "expected": {
            "ok": false,
            "error": "INVALID"
          }
        },
        {
          "input": {
            "raw": "{\"x\":NaN}"
          },
          "expected": {
            "ok": false,
            "error": "INVALID"
          }
        },
        {
          "input": {
            "raw": "[]"
          },
          "expected": {
            "ok": false,
            "error": "INVALID"
          }
        },
        {
          "input": {
            "raw": "{\"nested\":{\"k\":1,\"k\":2}}"
          },
          "expected": {
            "ok": false,
            "error": "INVALID"
          }
        }
      ]
    },
    {
      "id": "PAGES-05",
      "category": "integration",
      "goal": "Fetch *all* available pages of ID lists, record page numbers actually requested, and accept completion only when the combined count equals expected_total. Return {status: COMPLETE|INCOMPLETE, ids: all visited IDs, calls: requested page numbers}.",
      "files": {
        "solution.py": "from pager import collect\n\ndef transform(d):\n    return collect(d[\"pages\"], d[\"expected_total\"])\n",
        "pager.py": "def collect(pages, expected_total):\n    ids=list(pages[0]) if pages else []\n    return {\"status\":\"COMPLETE\",\"ids\":ids,\"calls\":[1] if pages else []}\n"
      },
      "allowed_changes": [
        "pager.py",
        "solution.py"
      ],
      "public": [
